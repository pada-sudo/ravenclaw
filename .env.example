# Copy this file to .env and fill in real secrets before running locally or in production.
# NEVER commit .env to version control.

# Server port exposed on the host (compose.yaml maps host:${PORT} -> container:3000)
PORT=3000

# Session configuration
# SESSION_SECRET is reserved for future HMAC cookie signing. The current
# SQLite-backed session store uses opaque random tokens, but keep this strong
# in case signing is added later.
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
SESSION_TTL_SECONDS=28800

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Cookie flags
COOKIE_SECURE=false

# Comma-separated list of trusted origins for cross-origin write requests.
# Example: https://ddp.example.com,https://ddp-backoffice.example.com
TRUSTED_ORIGINS=

# Logging
LOG_LEVEL=info
